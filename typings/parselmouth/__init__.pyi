# Minimal stub for the parts of praat-parselmouth Jarvis uses (the package ships no type hints).
from collections.abc import Mapping
from typing import Any

import numpy as np
from numpy.typing import NDArray

class Pitch:
    @property
    def selected_array(self) -> Mapping[str, NDArray[np.float64]]: ...
    def xs(self) -> NDArray[np.float64]: ...

class Sound:
    def __init__(self, values: NDArray[Any], sampling_frequency: float = ...) -> None: ...
    @property
    def xmax(self) -> float: ...
    @property
    def values(self) -> NDArray[np.float64]: ...
    def to_pitch(
        self, time_step: float | None = ..., pitch_floor: float = ..., pitch_ceiling: float = ...
    ) -> Pitch: ...
