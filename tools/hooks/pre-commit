#!/usr/bin/env bash
# Git pre-commit hook: refuses a commit that stages a line naming something private
# (tools/check_private.py --staged), and one while lint or the affected non-local tests fail.
# Lint and tests are skipped when the commit stages no Python, stub, shell, TOML, Markdown or YAML
# file, no uv.lock and nothing in .github/, docs/, src/jarvis/ or tools/.
# Opt in with tools/install-hooks.sh, which copies this file into the repository's own hooks folder.
# jarvis-hook: installed by tools/install-hooks.sh
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Every commit, whatever it stages, and before git's variables go: a partial commit's own index is
# named by GIT_INDEX_FILE.
echo "pre-commit: tools/check_private.py --staged" >&2
if ! uv run --quiet python tools/check_private.py --staged; then
  echo "pre-commit: a staged line names something private; make it generic and commit again." >&2
  exit 1
fi

staged=$(mktemp "${TMPDIR:-/tmp}/jarvis-staged.XXXXXX")
trap 'rm -f -- "${staged}"' EXIT
# -z: names are NUL-separated, so spaces, newlines and quotes in a name cannot split or hide one.
git diff --cached --name-only -z --diff-filter=ACMRD >"${staged}"
relevant=false
while IFS= read -r -d '' path; do
  case "${path}" in
    *.py | *.pyi | *.sh | *.toml | *.md | *.yml | uv.lock | */uv.lock | .github/* | docs/* | src/jarvis/* | tools/*)
      relevant=true
      ;;
    *) ;;
  esac
done <"${staged}"
if ! "${relevant}"; then
  echo "pre-commit: skipped lint and tests, no relevant staged files." >&2
  exit 0
fi

# Select from the commit's index before unsetting GIT_INDEX_FILE for lint and pytest.
skip_reason="no affected test files"
if [[ ! -f tools/affected_tests.py ]]; then
  # Installed hooks are shared with worktrees that may predate the selector.
  : >"${staged}"
  skip_reason="this worktree has no affected-test selector"
elif ! uv run --quiet python tools/affected_tests.py --staged --null >"${staged}"; then
  echo "pre-commit: could not select affected tests." >&2
  exit 1
fi

# Git exports repository context to hooks. The tests create their own repositories; keeping GIT_DIR or
# GIT_INDEX_FILE would make their git commands modify this checkout instead.
git_context=$(git rev-parse --local-env-vars)
while IFS= read -r variable; do
  unset "${variable}"
done <<<"${git_context}"

echo "pre-commit: uv run .lint/check.sh" >&2
if ! uv run .lint/check.sh; then
  echo "pre-commit: the checks found problems; fix them and commit again." >&2
  exit 1
fi

if [[ ! -s ${staged} ]]; then
  echo "pre-commit: skipped pytest, ${skip_reason}." >&2
  exit 0
fi

mapfile -d '' -t tests <"${staged}"
printf 'pre-commit: uv run pytest -q -m "not local"' >&2
printf ' %q' "${tests[@]}" >&2
printf '\n' >&2
pytest_status=0
PIPEWIRE_REMOTE=/nonexistent PULSE_SERVER=unix:/nonexistent uv run pytest -q -m "not local" "${tests[@]}" || pytest_status=$?
case "${pytest_status}" in
  0) ;;
  5) echo "pre-commit: no non-local tests collected from the affected files." >&2 ;;
  *)
    echo "pre-commit: a test failed; fix it and commit again." >&2
    exit 1
    ;;
esac
