#!/usr/bin/env bash
# Git pre-push hook: refuses a push whose new commits add a line, or carry a message, that names
# something private (tools/check_private.py --push, with the maintainer's private list when present).
# Opt in with tools/install-hooks.sh, which copies this file into the repository's own hooks folder.
# jarvis-hook: installed by tools/install-hooks.sh
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
if ! uv run --quiet python tools/check_private.py --push; then
  echo "pre-push: a commit names something private; make it generic before pushing." >&2
  exit 1
fi
