{
  "version": 1,
  "about": "Requests for tools/router_bench.py. A case says what a request needs: `expect` lists the calls that must run (each matched by a distinct call, in any order), `allow` the other tools a good answer may also call, `forbid` the ones that must not run. An argument is a value (strings compare ignoring case), or {contains}, {one_of}, {lt}, {gt}. {any_of} lists alternatives for one expected call. Core tools (no_action, use_tools, ...) are never extra. `channels` limits a case to the channels that offer its tools; `set` is typed (written requests) or spoken (short, as transcribed speech comes).",
  "cases": [
    {
      "id": "play_artist",
      "group": "music",
      "set": "typed",
      "turns": ["Play something by Radiohead."],
      "expect": [{"tool": "spotify_play", "args": {"kind": "artist", "query": {"contains": "radiohead"}}}]
    },
    {
      "id": "play_track",
      "group": "music",
