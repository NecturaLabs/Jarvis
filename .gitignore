# Python (from github/gitignore Python.gitignore, trimmed to what uv projects produce)
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Agent worktrees and scratch
.claude/worktrees/
.claude/settings.local.json
.lint-backup/
/tmp/

# Local environment
.env
.env.*

# Models, recordings, keys and tokens never belong in git
*.wav
*.onnx
*.npz
*.pem
*.key
config.toml
spotify-token.json
strata.env
model.env
audit.jsonl*

# The owner's private files: kept locally, never published
docs/directives.md
.claude/settings.json
# Your own Jarvis config lives in ~/.config/jarvis/; a copy here is never committed.
/config.toml
